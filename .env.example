# =============================================================================
# LinguaBridge — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed.
#
# SECURITY NOTE
# -------------
# None of these variables are prefixed with `NEXT_PUBLIC_`. That is deliberate
# and load-bearing: Next.js only inlines `NEXT_PUBLIC_*` variables into the
# browser bundle. Everything below is read exclusively in server-side code
# (route handlers under src/app/api/**), so no key value ever reaches the
# client. Do not rename any of these with a NEXT_PUBLIC_ prefix.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DATABASE (required)
# -----------------------------------------------------------------------------
# A PostgreSQL connection string. Free options:
#   - Neon      https://neon.tech          (recommended; serverless, generous free tier)
#   - Supabase  https://supabase.com       (use the "Connection pooling" / port 6543 URI)
#
# Neon example:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=


# -----------------------------------------------------------------------------
# 2. SESSION SIGNING (required)
# -----------------------------------------------------------------------------
# Secret used to sign the session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# -----------------------------------------------------------------------------
# 3. AI PROVIDERS (optional — app runs in deterministic mock mode without them)
# -----------------------------------------------------------------------------
# Primary provider: OpenAI GPT-4o-mini.  https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backup provider: Google Gemini 2.5 Flash. Used automatically when the primary
# provider errors, rate-limits, or times out.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to force deterministic mock AI output and skip all network
# calls, even when keys are present. Useful for demos and CI.
AI_MOCK_MODE=false
